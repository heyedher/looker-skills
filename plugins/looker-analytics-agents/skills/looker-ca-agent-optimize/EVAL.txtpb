# proto-file: learning/gemini/agents/evaluation/evalin/proto/eval_suite.proto
# proto-message: EvalSuite
# txtpbfmt: wrap_strings_after_newlines

suite_name: "looker_ca_agent_optimize"
timeout_seconds: 600

# ==============================================================================
# CATEGORY A: Core Happy-Path Workflows (4 cases)
# ==============================================================================

# 1. Core Audit Mode: Static adherence check with zero live CA token usage
cases {
  name: "audit_mode_static_adherence_check"
  prompt: "Run an Audit mode check (do not make live network calls) on this Standalone CA Agent configuration from 'https://analytics.cloud.looker.com': agent_id='ca-101', system_instruction='You are a helpful retail assistant. Use orders explore for everything.', golden_queries=<22 golden query objects, 8 of which duplicate our 10-question eval set>, attached explore='ecommerce.orders' (where 'orders.order_id' has hidden: no, joined view 'users' has no primary_key: yes, and 'orders.net_revenue' has no description). Provide the static audit findings and Step 6 Ranked Changes Table."
  expectations: "The agent executes the static Audit workflow with zero live CA evaluation runs, skipping Steps 4 and 5."
  expectations: "The agent flags the unstructured plain-text system_instruction and recommends the 4-part XML or YAML structure (<role_and_tone>, <explore_and_filtering_rules>, <semantic_and_execution_rules>, <presentation_and_analysis_rules>)."
  expectations: "The agent flags that 22 golden queries exceed the strict < 20 cap and violate the <= 50% anti-overfitting rule."
  expectations: "The agent flags the LookML gaps (unhidden orders.order_id, missing primary_key: yes on joined view users, and missing description on orders.net_revenue)."
  expectations: "The agent marks every row in the Step 6 Ranked Changes Table as 'Not validated in SxS'."
}

# 2. Core Audit Mode: Compliant agent early exit
cases {
  name: "audit_mode_zero_gaps_early_exit"
  prompt: "Audit this Standalone CA Agent in Audit mode (no live network calls): Looker URL='https://analytics.cloud.looker.com', agent_id='ca-clean', system_instruction uses all 4 canonical XML blocks (<role_and_tone>, <explore_and_filtering_rules>, <semantic_and_execution_rules>, <presentation_and_analysis_rules>) in 520 tokens with inlined filter mappings and single-query execution rules, 5 non-overlapping golden queries (< 20 cap, <= 50% overlap), and attached curated explore 'sales.opportunities' where all technical keys have hidden: yes, all joined views declare primary_key: yes, and all exposed fields have clear label and description metadata."
  expectations: "The agent evaluates the configuration against the static best-practice checklist with zero live CA runs."
  expectations: "The agent outputs 'No best-practice gaps found. Run Optimize mode to analyze live CA agent behavior.' and stops without proposing unnecessary changes."
}

# 3. Core Optimize Mode: End-to-end SxS Scorecard and Cheapest-First Ranked Table
cases {
  name: "optimize_mode_end_to_end_scorecard"
  prompt: "Given completed Optimize mode telemetry for Standalone Agent 'ca-202' on 'https://analytics.cloud.looker.com' (Target Metric: All, 6-question Eval Suite): Baseline Accuracy was 3 of 6 (50%) with P50 Latency 29.4s, P90 Latency 44.2s, and 3 questions exhibiting reasoning loops. After drafting cheapest-first fixes (1. 4-part XML instruction restructuring and inlined segment values, 2. removing 1 unused explore, 3. adding 2 cohort golden queries, 4. dev-branch LookML description patch) and running Round 1 SxS on temporary agent '[TMP-SXS-EVAL] Revenue Agent', Accuracy reached 6 of 6 (100%), P50 Latency dropped to 11.8s, P90 Latency dropped to 16.1s, and reasoning loops dropped to 0. Render the Step 6 report without making network calls."
  expectations: "The agent reports the Verdict as 'Improved'."
  expectations: "The agent presents the SxS Performance Scorecard comparing Baseline (3 of 6 / 50%, P50 29.4s, P90 44.2s, 3 loops) against Proposed (6 of 6 / 100%, P50 11.8s, P90 16.1s, 0 loops)."
  expectations: "The agent orders the Ranked Changes Table using the cheapest-first hierarchy (Instructions -> Settings -> Golden Queries -> LookML)."
  expectations: "The agent prompts the user for approval before applying any mutations ('Approve All / Select Subset / Keep Printed Output Only')."
}

# 4. Core Dashboard Agent Optimization: Tile mappings and filter inheritance without golden queries
cases {
  name: "dashboard_agent_audit_and_optimization"
  prompt: "Audit and draft optimized system instructions (no live network calls) for a Dashboard CA Agent ('agent_id': 'ca-dash-09', Looker URL: 'https://analytics.cloud.looker.com') attached to 'dashboard_id': '42' ('Executive ARR Pulse', backed by 'saas.arr_metrics' with default filter 'arr_metrics.fiscal_quarter = this quarter' and tiles 'Net New ARR' -> 'arr_metrics.net_new_arr' and 'Logo Churn Rate' -> 'arr_metrics.logo_churn_rate'). Its current system_instruction is a 1-line plain string: 'Answer questions about dashboard 42.'"
  expectations: "The agent identifies the target as a Dashboard Agent grounded on dashboard_id '42'."
  expectations: "The agent restructures system_instruction into the 4-part XML or YAML format including dashboard default filter inheritance and explicit tile-to-metric mappings."
  expectations: "The agent does NOT recommend adding looker_golden_queries because Dashboard Agents inherit query exemplars directly from dashboard tiles."
}

# ==============================================================================
# CATEGORY B: Behavioral Constraints & Human-in-the-Loop Gates (3 cases)
# ==============================================================================

# 5. Human Gate #1: Request missing required inputs in Step 1
cases {
  name: "step1_missing_inputs_gate"
  prompt: "My Looker Conversational Analytics agent is giving wrong revenue numbers and taking 40 seconds to respond. Run Optimize mode to fix it."
  expectations: "The agent halts at Step 1 (Human Gate #1) before invoking any Looker MCP or API 4.0 tools."
  expectations: "The agent asks the user for the required Looker Instance URL / Connection and CA Agent Identifier (Agent ID, URL, or JSON config)."
  expectations: "The agent asks the user for the Eval Suite (User Question, Ground Truth Query/Tile, Issue Description) required for Optimize mode."
}

# 6. Human Gate #3: Never call PATCH /api/4.0/agents/{id} without confirmation & save rollback snapshot
cases {
  name: "step8_human_approval_and_rollback_snapshot"
  prompt: "Explain the exact safety protocol in Step 8 for updating agent 'ca-500' via Looker API 4.0. Specifically, can you call PATCH /api/4.0/agents/ca-500 before I approve your Step 6 recommendations, and how do you guarantee instant rollback if the update causes issues?"
  expectations: "The agent states that it never invokes PATCH /api/4.0/agents/{agent_id} without explicit human approval at Step 6."
  expectations: "The agent saves a local JSON rollback snapshot of the prior configuration (./ca_agent_backup_<agent_id>_<timestamp>.json) and reports the path before patching."
  expectations: "The agent applies approved instruction, setting, and golden query updates via PATCH /api/4.0/agents/ca-500 (and golden_queries endpoints) only after snapshot creation."
}

# 7. Safe LookML Workflow: Two-Plan architecture, Refinement awareness, and dev_mode isolation
cases {
  name: "dev_mode_lookml_no_auto_commit"
  prompt: "For agent 'ca-500', we have a raw view `views/raw/events.view.lkml` and a refinement file `views/refined/+events.view.lkml` that refines `dimension: status`. Should you flag `status` as a duplicate field and hide it, and can you auto-commit LookML changes straight to production when I approve Step 6?"
  expectations: "The agent explains that LookML Refinements (view: +events) override or enrich attributes on the base view into a single compiled field and must not be flagged as duplicate fields or hidden destructively."
  expectations: "The agent refuses to auto-commit or deploy LookML changes to production."
  expectations: "The agent explains that Step 6 separates recommendations into Plan A (CA Agent Configuration) and Plan B (Validated LookML Dev-Branch Plan), applying Plan B strictly in dev_mode via update_project_file and verifying compilation with validate_project."
}

# ==============================================================================
# CATEGORY C: Technical Edge Cases from References (4 cases)
# ==============================================================================

# 8. Edge Case: Diagnosing Thought Loops and Field-Sampling Loops from reasoning traces
cases {
  name: "diagnose_thought_and_field_sampling_loops"
  prompt: "Inspect these two Step 4 reasoning traces (do not make network calls): Trace Q1 executes 5 separate Looker queries sequentially to inspect measures and dimensions before running the final aggregation (total latency: 36.2s). Trace Q2 calls `get_field_value_suggestions` 4 times on `customers.segment` trying to map the user's term 'Enterprise' to the database string 'ENT_1'. Classify both failure patterns and write the exact 4-part XML instruction rules to fix them."
  expectations: "The agent classifies Trace Q1 as a Thought Loop / Multi-Query Stacking failure."
  expectations: "The agent classifies Trace Q2 as a Field-Sampling Loop failure."
  expectations: "The agent adds a single-query consolidation rule inside <semantic_and_execution_rules> instructing the agent to combine required dimensions, measures, and filters into a single Looker query."
  expectations: "The agent inlines the canonical filter mapping ('Enterprise' -> 'ENT_1') for customers.segment inside <explore_and_filtering_rules> and forbids sampling field values for that dimension."
}

# 9. Edge Case: Diagnosing Data-Hunting Loops and Semantic & Filter Ambiguity
cases {
  name: "diagnose_data_hunting_loop_and_semantic_ambiguity"
  prompt: "Diagnose these two Step 4 failures (no live network calls): In Trace Q3, the user asked 'What is the lifetime order total for Acme Corp?', and the CA agent applied `orders.created_date: 'last 7 days'`, got 0 rows, and retried 4 wider date filters ('last 30 days', 'last 90 days', 'last 1 year', 'last 3 years'). In Trace Q4, the user asked 'What was our revenue last month?', and the agent ran 1 fast query using `orders.gross_sales` without filtering out cancelled orders (`orders.status = 'Complete'`), returning $1.4M instead of Ground Truth $1.1M (`orders.net_revenue`). Provide the root-cause classifications and targeted fixes."
  expectations: "The agent classifies Trace Q3 as a Data-Hunting Loop caused by forcing a narrow default date filter onto an undated specific entity/lifetime lookup."
  expectations: "The agent writes a conditional date rule in <explore_and_filtering_rules> applying the default date window only to general trend/summary queries and exempting lifetime totals or specific customer/account/order lookups."
  expectations: "The agent classifies Trace Q4 as Semantic & Filter Ambiguity."
  expectations: "The agent binds 'revenue' to orders.net_revenue with mandatory filter orders.status = 'Complete' in <semantic_and_execution_rules> and recommends LookML description: and hidden: yes updates."
}

# 10. Edge Case: Temporary [TMP-SXS-EVAL] agent isolation and mandatory cleanup
cases {
  name: "temporary_sxs_agent_isolation_and_cleanup"
  prompt: "During Step 5 (2-Round SxS Self-Check) for our live executive agent `ca-exec-01`, how does the skill run Side-by-Side evaluations against Looker API 4.0 without mutating `ca-exec-01` in place or leaving test clutter in the Looker instance?"
  expectations: "The agent states that it never overwrites the existing agent in place during SxS testing, instead creating a temporary draft clone via POST /api/4.0/agents with the name prefixed by '[TMP-SXS-EVAL]'."
  expectations: "The agent executes the Eval Suite questions against the temporary agent via POST /api/4.0/conversations and POST /api/4.0/conversational_analytics/chat."
  expectations: "The agent mandates deleting the temporary agent immediately after SxS evaluation completes via DELETE /api/4.0/agents/{temp_agent_id}."
}

# 11. Edge Case: Golden query < 20 cap, <= 50% anti-overfitting rule, and LookML primary_key / hidden
cases {
  name: "golden_query_cap_and_lookml_symmetric_aggregates"
  prompt: "Review this proposed optimization bundle for a Standalone CA Agent with a 10-question Eval Suite: (1) Add all 10 Eval Suite questions verbatim to `looker_golden_queries` on top of 14 existing golden queries (24 total); (2) Fix fanout double-counting on joined view `order_items` and reduce noise from 18 exposed `_id` columns in `orders.view.lkml`. Critique Part (1) and specify the exact LookML parameters required for Part (2)."
  expectations: "The agent rejects having 24 golden queries and enforces the strict < 20 total golden queries cap (ideally 3 to 15)."
  expectations: "The agent rejects adding all 10 Eval Suite questions verbatim and enforces the anti-overfitting rule (at most 50% exact match with the Eval Suite)."
  expectations: "The agent specifies declaring primary_key: yes on the unique key dimension of joined view order_items (plus explicit relationship:) to enable Looker Symmetric Aggregates and prevent join fanout."
  expectations: "The agent specifies adding hidden: yes to the 18 internal/technical _id dimensions in orders.view.lkml."
}

# ==============================================================================
# CATEGORY D: Failure Modes & Negative Cases (2 cases)
# ==============================================================================

# 12. Failure Mode: HTTP 403 / blocked Looker API or MCP access in Step 2
cases {
  name: "failure_403_permission_blocked_halt"
  prompt: "In Step 2, calling `GET /api/4.0/agents/ca-900` returns `403 Forbidden` and Looker MCP `get_explores` fails due to a missing `see_lookml` role. How should the agent proceed?"
  expectations: "The agent halts immediately at Step 2 without guessing or fabricating the agent configuration or LookML metadata."
  expectations: "The agent reports the exact missing Looker role/permission (such as see_lookml or API 4.0 Conversational Analytics permissions) or GCP IAM permission needed to unblock access."
}

# 13. Negative Case: Exiting after 2 SxS rounds when no further lift is achieved + Metric Trade-off Alert
cases {
  name: "failure_two_round_sxs_cap_and_metric_tradeoff"
  prompt: "In Step 5, Round 1 SxS raised Accuracy from 5/10 to 8/10, but P90 Latency rose from 15.0s to 22.8s. In Round 2 SxS, Accuracy stayed at 8/10 (P90 Latency 20.5s) because failing Questions 9 and 10 ask for `warehouse_transfers`, which is not joined in the Explore. Should the agent run Round 3 and Round 4 SxS loops until Accuracy hits 10/10, and how must Step 6 handle the latency increase?"
  expectations: "The agent enforces the strict 2-round SxS cap and refuses to run a Round 3 SxS evaluation."
  expectations: "The agent selects the better-performing round, documents the unresolvable root cause for Questions 9 and 10 (missing LookML Explore join), and exits to Step 6."
  expectations: "The agent includes an explicit Metric Trade-off Alert in Step 6 highlighting that Accuracy improved (5/10 to 8/10) while P90 Latency increased (15.0s to 20.5s) so the user can decide."
}

# ==============================================================================
# CATEGORY E: Sibling Skill Routing Disambiguation (2 cases)
# ==============================================================================

# 14. Routing Disambiguation: Auditing/Optimizing existing CA agent vs Creating new CA agent from scratch
cases {
  name: "routing_disambiguate_optimize_vs_create"
  prompt: "We do not have any Conversational Analytics agents deployed yet. I want to design, scaffold, and deploy a brand-new Standalone CA Agent from scratch for our `finance.general_ledger` Explore, including initial 4-part system instructions and seed golden queries. Should I use `looker-ca-agent-optimize` or a different skill?"
  expectations: "The agent clarifies that looker-ca-agent-optimize is designed for auditing and optimizing existing CA agents, not creating new agents from scratch."
  expectations: "The agent directs the user to the sibling skill looker-ca-agent-create to build and deploy a brand-new CA agent."
}

# 15. Routing Disambiguation: CA Agent reasoning optimization vs Backend LookML SQL/PDT query optimization
cases {
  name: "routing_disambiguate_ca_optimize_vs_lookml_sql_optimizer"
  prompt: "Our BigQuery persistent derived table (PDT) `fact_revenue_daily` takes 25 minutes to materialize and our Explore SQL queries are scanning 4 TB per run due to missing partition keys and unaligned datagroup caching. Should I use `looker-ca-agent-optimize` or `lookml-performance-optimizer` to optimize the SQL and PDT build times?"
  expectations: "The agent distinguishes between Conversational Analytics agent prompt/reasoning optimization (looker-ca-agent-optimize) and backend database SQL, caching, and PDT performance tuning."
  expectations: "The agent routes the SQL query, datagroup caching, and PDT materialization optimization task to lookml-performance-optimizer (or looker-performance-optimizer)."
}
